# Kill Switch Server Configuration
# Copy to .env and adjust values for your environment

# Database path (use :memory: for ephemeral dev, file path for persistence)
DB_PATH=data/npcwars.db

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# Host port the arena is published on (container port is always 8000).
# Override when 8000 is already taken on the host — e.g. ARENA_HOST_PORT=8010.
ARENA_HOST_PORT=8000

# Redis URL (falls back to an in-process queue if unavailable, unless strict)
REDIS_URL=redis://localhost:6379

# Require Redis: with strict mode on, an unreachable Redis is a hard startup
# failure instead of a silent in-process queue that strands every job (the app
# and the worker are separate processes and would never see each other's jobs).
# docker-compose sets this to 1. Leave unset for single-process local dev.
NPCWARS_QUEUE_STRICT=

# Log level for the API and the worker (DEBUG/INFO/WARNING/ERROR)
NPCWARS_LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
NPCWARS_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Secure cookies (set to 0 for local dev without HTTPS)
NPCWARS_SECURE_COOKIES=1

# Match results directory
RESULTS_DIR=results

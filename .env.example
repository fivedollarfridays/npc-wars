# Kill Switch Server Configuration
# Copy to .env and adjust values for your environment

# Database path (use :memory: for ephemeral dev, file path for persistence)
DB_PATH=data/npcwars.db

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# Redis URL (optional — falls back to in-memory queue if unavailable)
REDIS_URL=redis://localhost:6379

# CORS allowed origins (comma-separated)
NPCWARS_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Secure cookies (set to 0 for local dev without HTTPS)
NPCWARS_SECURE_COOKIES=1

# Match results directory
RESULTS_DIR=results
